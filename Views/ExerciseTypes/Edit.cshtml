@model ExerciseType
@{ViewData["Title"]=Model.Id==0?"Dodaj ćwiczenie":"Edytuj ćwiczenie";}
<div class="form-card wide"><h1>@ViewData["Title"]</h1><form method="post"><div asp-validation-summary="All"></div><label asp-for="Name"></label><input asp-for="Name" required/><span asp-validation-for="Name"></span><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description"></span><div class="actions"><button>Zapisz</button><a asp-action="Index">Anuluj</a></div></form></div>