@model PerformedExercise
@{ViewData["Title"]=Model.Id==0?"Dodaj wykonanie":"Edytuj wykonanie";}
<div class="form-card wide"><h1>@ViewData["Title"]</h1><p>Nie masz treningu? <a asp-controller="TrainingSessions" asp-action="Create">Dodaj trening</a>.</p><form method="post"><div asp-validation-summary="All"></div><label asp-for="TrainingSessionId"></label><select asp-for="TrainingSessionId" asp-items="ViewBag.Sessions" required><option value="">Wybierz…</option></select><span asp-validation-for="TrainingSessionId"></span><label asp-for="ExerciseTypeId"></label><select asp-for="ExerciseTypeId" asp-items="ViewBag.Types" required><option value="">Wybierz…</option></select><span asp-validation-for="ExerciseTypeId"></span><label asp-for="Weight"></label><input asp-for="Weight" type="text" inputmode="decimal" required/><small>Od 0 do 1000 kg. Użyj przecinka, np. 12,5. Przy masie własnego ciała wpisz 0.</small><span asp-validation-for="Weight"></span><label asp-for="Sets"></label><input asp-for="Sets" type="number" required/><span asp-validation-for="Sets"></span><label asp-for="Repetitions"></label><input asp-for="Repetitions" type="number" required/><span asp-validation-for="Repetitions"></span><div class="actions"><button>Zapisz</button><a asp-action="Index">Anuluj</a></div></form></div>