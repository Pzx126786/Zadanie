@model RegisterModel
@{ViewData["Title"]="Utwórz konto";}
<div class="form-card"><h1>Utwórz konto</h1><p class="muted">Twoje treningi i wyniki będą widoczne tylko dla Ciebie.</p><form method="post"><div asp-validation-summary="All"></div><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" maxlength="254" required/><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" minlength="10" maxlength="128" required/><small>Od 10 do 128 znaków.</small><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" required/><button>Utwórz konto</button></form><p>Masz już konto? <a asp-action="Login">Zaloguj się</a></p></div>