@model List<TrainingSession>
@{ViewData["Title"]="Moje treningi";}
<div class="page-heading"><div><h1>Moje treningi</h1></div><a class="button" asp-action="Create">Dodaj trening</a></div>
@if(Model.Count==0){<div class="empty"><h2>Czas na pierwszy trening</h2><p>Dodaj sesję, a potem zapisz wykonane ćwiczenia.</p><a class="button" asp-action="Create">Zapisz pierwszy trening</a></div>}else{<div class="table-wrap"><table><thead><tr><th>Trening</th><th>Rozpoczęcie</th><th>Czas</th><th>Ćwiczenia</th><th>Opcje</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td><td>@item.Start.ToString("dd.MM.yyyy HH:mm")</td><td>@((int)(item.End-item.Start).TotalMinutes) min</td><td>@item.Exercises.Count</td><td class="actions"><a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a><a asp-action="Delete" asp-route-id="@item.Id">Usuń</a></td></tr>}</tbody></table></div>}