@model List<PerformedExercise>
@{ViewData["Title"]="Wykonane ćwiczenia";}
<div class="page-heading"><div><h1>Wykonane ćwiczenia</h1><p>Wszystkie Twoje wpisy, od najnowszego treningu.</p></div><a class="button" asp-action="Create">Dodaj wykonanie</a></div>@if(Model.Count==0){<div class="empty"><p>Brak zapisanych wykonań. Najpierw utwórz trening.</p><a asp-controller="TrainingSessions" asp-action="Create">Dodaj trening</a></div>}else{<div class="table-wrap"><table><thead><tr><th>Ćwiczenie</th><th>Trening</th><th>Data</th><th>Serie × powtórzenia</th><th>Obciążenie</th><th>Opcje</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.ExerciseType?.Name</a></td><td><a asp-controller="TrainingSessions" asp-action="Details" asp-route-id="@item.TrainingSessionId">@item.TrainingSession?.Name</a></td><td>@item.TrainingSession?.Start.ToString("dd.MM.yyyy")</td><td>@item.Sets × @item.Repetitions</td><td>@item.Weight.ToString("0.##") kg</td><td class="actions"><a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a><a asp-action="Delete" asp-route-id="@item.Id">Usuń</a></td></tr>}</tbody></table></div>}