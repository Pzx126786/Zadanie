@model TrainingSession
@{ViewData["Title"]=Model.Id==0?"Dodaj trening":"Edytuj trening";}
<div class="form-card wide"><h1>@ViewData["Title"]</h1><form method="post"><div asp-validation-summary="All"></div><label asp-for="Name"></label><input asp-for="Name" required/><span asp-validation-for="Name"></span><label asp-for="Start"></label><input asp-for="Start" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required/><span asp-validation-for="Start"></span><label asp-for="End"></label><input asp-for="End" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required/><span asp-validation-for="End"></span><label asp-for="Notes"></label><textarea asp-for="Notes" rows="4"></textarea><span asp-validation-for="Notes"></span><div class="actions"><button>Zapisz</button><a asp-action="Index">Anuluj</a></div></form></div>