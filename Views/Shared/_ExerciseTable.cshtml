@model List<PerformedExercise>
<div class="table-wrap"><table><thead><tr><th>Ćwiczenie</th><th>Obciążenie</th><th>Serie</th><th>Powtórzenia w serii</th><th>Opcje</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a asp-controller="PerformedExercises" asp-action="Details" asp-route-id="@item.Id">@item.ExerciseType?.Name</a></td><td>@item.Weight.ToString("0.##") kg</td><td>@item.Sets</td><td>@item.Repetitions</td><td class="actions"><a asp-controller="PerformedExercises" asp-action="Edit" asp-route-id="@item.Id">Edytuj</a><a asp-controller="PerformedExercises" asp-action="Delete" asp-route-id="@item.Id">Usuń</a></td></tr>}</tbody></table></div>